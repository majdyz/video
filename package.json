{
  "name": "dive-tools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:aqua": "pnpm --filter aqua-fix dev",
    "dev:motion": "pnpm --filter motion-fix dev",
    "build": "pnpm --filter aqua-fix build && pnpm --filter motion-fix build && pnpm --filter dewarp build && pnpm --filter studio build && node scripts/assemble-dist.mjs",
    "check:shaders": "node --experimental-strip-types --no-warnings scripts/check-shaders.ts",
    "dev:studio": "pnpm --filter studio dev",
    "build:studio": "pnpm --filter studio build",
    "build:aqua": "pnpm --filter aqua-fix build",
    "build:motion": "pnpm --filter motion-fix build",
    "preview": "vite preview --outDir dist",
    "predeploy": "pnpm check:shaders && pnpm build",
    "deploy": "gh-pages -d dist --nojekyll",
    "dev:dewarp": "pnpm --filter dewarp dev",
    "build:dewarp": "pnpm --filter dewarp build",
    "test:dewarp": "pnpm --filter dewarp test"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "vite": "^8.0.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
